# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Ruby files
[*.rb]
indent_size = 4

# ERB files
[*.erb]
indent_size = 4

# JavaScript files
[*.js]
indent_size = 4

# CSS files
[*.css]
indent_size = 4

# HTML files
[*.html]
indent_size = 4

# JSON files
[*.json]
indent_size = 4

# YAML files
[*.yml,*.yaml]
indent_size = 4

# Markdown files
[*.md]
indent_size = 4
trim_trailing_whitespace = false

# Package.json and similar
[package.json]
indent_size = 4
