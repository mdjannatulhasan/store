<header class="bg-white shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-6">
            <!-- Logo -->
            <div class="flex-shrink-0">
                <%= render 'shared/atoms/link', 
                    url: '/', 
                    text: '🛍️ My Store', 
                    class: 'text-2xl font-bold text-gray-900' %>
            </div>

            <!-- Desktop Navigation -->
            <nav class="hidden md:flex space-x-8">
                <%= render 'shared/molecules/navigation_item', 
                    url: '/', 
                    text: 'Home', 
                    is_active: current_page?('/') %>
                <%= render 'shared/molecules/navigation_item', 
                    url: '/about', 
                    text: 'About', 
                    is_active: current_page?('/about') %>
                <%= render 'shared/molecules/navigation_item', 
                    url: '#', 
                    text: 'Products', 
                    is_active: false %>
                <%= render 'shared/molecules/navigation_item', 
                    url: '#', 
                    text: 'Contact', 
                    is_active: false %>
            </nav>

            <!-- Mobile menu button -->
            <div class="md:hidden">
                <button 
                    data-controller="mobile-menu" 
                    data-action="click->mobile-menu#toggle" 
                    class="text-gray-700 hover:text-blue-600 focus:outline-none focus:text-blue-600"
                    aria-label="Toggle mobile menu">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation -->
        <div 
            data-controller="mobile-menu" 
            data-mobile-menu-target="menu" 
            class="md:hidden hidden">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
                <%= render 'shared/molecules/navigation_item', 
                    url: '/', 
                    text: 'Home', 
                    is_active: current_page?('/'), 
                    mobile: true %>
                <%= render 'shared/molecules/navigation_item', 
                    url: '/about', 
                    text: 'About', 
                    is_active: current_page?('/about'), 
                    mobile: true %>
                <%= render 'shared/molecules/navigation_item', 
                    url: '#', 
                    text: 'Products', 
                    is_active: false, 
                    mobile: true %>
                <%= render 'shared/molecules/navigation_item', 
                    url: '#', 
                    text: 'Contact', 
                    is_active: false, 
                    mobile: true %>
            </div>
        </div>
    </div>
</header>